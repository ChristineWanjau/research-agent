# LLM provider: groq (default) | gemini | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Optional smaller model for the critic (higher free-tier limits on Groq)
CRITIC_MODEL=llama-3.1-8b-instant

# Free keys: https://console.groq.com  |  https://aistudio.google.com
GROQ_API_KEY=
GOOGLE_API_KEY=

# Free key: https://tavily.com (leave blank to use DuckDuckGo only)
TAVILY_API_KEY=

# Limits
MAX_REVISIONS=2
# Critic score needed to pass (1-10). Set to 10 to force revision loops for a demo.
PASS_SCORE=7
MAX_RESULTS=3
MAX_SOURCE_CHARS=1500
MAX_CONCURRENCY=2

REPORTS_DIR=reports
DB_PATH=.checkpoints.sqlite
