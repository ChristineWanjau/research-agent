# LLM provider: groq (default) | gemini | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Optional smaller model for the critic (higher free-tier limits on Groq)
CRITIC_MODEL=llama-3.1-8b-instant
# Backup provider when the main one fails (e.g. rate limits). Leave GOOGLE_API_KEY blank to disable.
FALLBACK_PROVIDER=gemini
FALLBACK_MODEL=gemini-2.5-flash

# Development only: cache LLM responses on disk so re-runs don't spend quota
LLM_CACHE=false
LLM_CACHE_PATH=.llm_cache.sqlite

# Free keys: https://console.groq.com  |  https://aistudio.google.com
GROQ_API_KEY=
GOOGLE_API_KEY=

# Free key: https://tavily.com (leave blank to use DuckDuckGo only)
TAVILY_API_KEY=

# Limits
MAX_REVISIONS=2
# Critic score needed to pass (1-10). Set to 10 to force revision loops for a demo.
PASS_SCORE=7
MAX_RESULTS=3
MAX_SOURCE_CHARS=1500
MAX_CONCURRENCY=2
# Searches the researcher may choose per sub-question (0 = search each sub-question as written)
RESEARCH_TOOL_CALLS=2

# RAG: fetch full pages and embed them locally (requires `ollama pull nomic-embed-text`)
RAG=true
EMBEDDING_MODEL=nomic-embed-text
RETRIEVAL_K=4

REPORTS_DIR=reports
DB_PATH=.checkpoints.sqlite

# Optional LangSmith tracing: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
